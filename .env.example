GEMINI_API_KEY=coloque_sua_chave_do_google_aqui_sem_aspas

# Mercado Pago — obtenha em: https://www.mercadopago.com.br/developers/panel/app
MERCADO_PAGO_ACCESS_TOKEN=coloque_seu_access_token_do_mercado_pago_aqui
# "sandbox" para testes | "production" para cobranças reais
MP_ENV=sandbox
# Email do comprador de teste (só necessário no sandbox)
MP_TEST_PAYER_EMAIL=coloque_email_do_comprador_de_teste_aqui
